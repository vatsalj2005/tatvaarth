  "chapters": [
    {
      "name": "मंगलाचरण",
      "items": [
        {
          "file": "0000_शास्त्र-मंगलाचरण.txt",
          "gathaNum": "000",
          "title": "शास्त्र-मंगलाचरण"
        }
      ]
    },
    {
      "name": "मूल ग्रंथ",
      "items": [
        {
          "file": "001.txt",
          "gathaNum": "001",
          "title": "नमः समयसाराय स्वानुभूत्या चकासते"
        },
        {
          "file": "002.txt",
          "gathaNum": "002",
          "title": "अनंतधर्मणस्तत्त्वं पश्यंती प्रत्यगात्मनः"
        },
        {
          "file": "003.txt",
          "gathaNum": "003",
          "title": "परपरिणतिहेतोर्मोहनाम्नोऽनुभावा"
        },
        {
          "file": "004.txt",
          "gathaNum": "004",
          "title": "उभयनयविरोधध्वंसिनि स्यात्पदांके"
        },
        {
          "file": "005.txt",
          "gathaNum": "005",
          "title": "व्यवहरणनयः स्याद्यद्यपि प्राक्पदव्या"
        },
        {
          "file": "006.txt",
          "gathaNum": "006",
          "title": "एकत्वे नियतस्य शुद्धनयतो व्याप्तुर्यदस्यात्मनः"
        },
        {
          "file": "007.txt",
          "gathaNum": "007",
          "title": "अतः शुद्धनयायत्तं प्रत्यग्ज्योतिश्चकास्ति तत्"
        },
        {
          "file": "008.txt",
          "gathaNum": "008",
          "title": "चिरमिति नवतत्त्वच्छन्नमुन्नीयमानं"
        },
        {
          "file": "009.txt",
          "gathaNum": "009",
          "title": "उदयति न नयश्रीरस्तमेति प्रमाणं"
        },
        {
          "file": "010.txt",
          "gathaNum": "010",
          "title": "आत्मस्वभावं परभावभिन्न"
        },
        {
          "file": "011.txt",
          "gathaNum": "011",
          "title": "न हि विदधति बद्धस्पृष्टभावादयोऽमी"
        },
        {
          "file": "012.txt",
          "gathaNum": "012",
          "title": "भूतं भान्तमभूतमेव रभसान्निर्भिद्य बन्धं सुधी"
        },
        {
          "file": "013.txt",
          "gathaNum": "013",
          "title": "आत्मानुभूतिरिति शुद्धनयात्मिका या"
        },
        {
          "file": "014.txt",
          "gathaNum": "014",
          "title": "अखण्डितमनाकुलं ज्वलदनन्तमन्तर्बहि"
        },
        {
          "file": "015.txt",
          "gathaNum": "015",
          "title": "एष ज्ञानघनो नित्यमात्मा सिद्धिमभीप्सुभिः"
        },
        {
          "file": "016.txt",
          "gathaNum": "016",
          "title": "दर्शनज्ञानचारित्रैस्त्रित्वादेकत्वतः स्वयम्"
        },
        {
          "file": "017.txt",
          "gathaNum": "017",
          "title": "दर्शनज्ञानचारित्रैस्त्रिभिः परिणतत्वतः"
        },
        {
          "file": "018.txt",
          "gathaNum": "018",
          "title": "परमार्थेन तु व्यक्तज्ञातृत्वज्योतिषैककः"
        },
        {
          "file": "019.txt",
          "gathaNum": "019",
          "title": "आत्मनश्चिन्तयैवालं मेचकामेचकत्वयोः"
        },
        {
          "file": "020.txt",
          "gathaNum": "020",
          "title": "कथमपि समुपात्तत्रित्वमप्येकताया"
        },
        {
          "file": "021.txt",
          "gathaNum": "021",
          "title": "कथमपि हि लभन्ते भेदविज्ञानमूला"
        },
        {
          "file": "022.txt",
          "gathaNum": "022",
          "title": "त्यजतु जगदिदानीं मोहमाजन्मलीनं"
        },
        {
          "file": "023.txt",
          "gathaNum": "023",
          "title": "अयि कथमपि मृत्वा तत्त्वकौतूहली सन्"
        },
        {
          "file": "024.txt",
          "gathaNum": "024",
          "title": "कान्त्यैव स्नपयन्ति ये दशदिशो धाम्ना निरुन्धन्ति ये"
        },
        {
          "file": "025.txt",
          "gathaNum": "025",
          "title": "प्राकारकवलिताम्बरमुपवनराजीनिगीर्णभूमितलम्"
        },
        {
          "file": "026.txt",
          "gathaNum": "026",
          "title": "नित्यमविकारसुस्थितसर्वांगमपूर्वसहजलावण्यम्"
        },
        {
          "file": "027.txt",
          "gathaNum": "027",
          "title": "एकत्वं व्यवहारतो न तु पुनः कायात्मनोर्निश्चया"
        },
        {
          "file": "028.txt",
          "gathaNum": "028",
          "title": "इति परिचिततत्त्वैरात्मकायैकतायां"
        },
        {
          "file": "029.txt",
          "gathaNum": "029",
          "title": "अवतरति न यावद् वृत्तिमत्यन्तवेगा"
        },
        {
          "file": "030.txt",
          "gathaNum": "030",
          "title": "सर्वतः स्वरसनिर्भरभावं"
        },
        {
          "file": "031.txt",
          "gathaNum": "031",
          "title": "इति सति सह सर्वैरन्यभावैर्विवेके"
        },
        {
          "file": "032.txt",
          "gathaNum": "032",
          "title": "मज्जन्तु निर्भरममी सममेव लोका"
        },
        {
          "file": "033.txt",
          "gathaNum": "033",
          "title": "जीवाजीवविवेकपुष्कलदृशा प्रत्याययत्पार्षदान्"
        },
        {
          "file": "034.txt",
          "gathaNum": "034",
          "title": "विरम किमपरेणाकार्यकोलाहलेन"
        },
        {
          "file": "035.txt",
          "gathaNum": "035",
          "title": "सकलमपि विहायाह्नाय चिच्छक्तिरिक्तं"
        },
        {
          "file": "036.txt",
          "gathaNum": "036",
          "title": "चिच्छक्तिव्याप्तसर्वस्वसारो जीव इयानयम्"
        },
        {
          "file": "037.txt",
          "gathaNum": "037",
          "title": "वर्णाद्या वा रागमोहादयो वा"
        },
        {
          "file": "038.txt",
          "gathaNum": "038",
          "title": "निर्वर्त्यते येन यदत्र किंचित्"
        },
        {
          "file": "039.txt",
          "gathaNum": "039",
          "title": "वर्णादिसामग्र्यमिदं विदन्तु"
        },
        {
          "file": "040.txt",
          "gathaNum": "040",
          "title": "घृतकुम्भाभिधानेऽपि कुम्भो घृतमयो न चेत्"
        },
        {
          "file": "041.txt",
          "gathaNum": "041",
          "title": "अनाद्यनन्तमचलं स्वसंवेद्यमिदं स्फुटम्"
        },
        {
          "file": "042.txt",
          "gathaNum": "042",
          "title": "वर्णाद्यैः सहितस्तथा विरहितो द्वेधास्त्यजीवो यतो"
        },
        {
          "file": "043.txt",
          "gathaNum": "043",
          "title": "जीवादजीवमिति लक्षणतो विभिन्नं"
        },
        {
          "file": "044.txt",
          "gathaNum": "044",
          "title": "अस्मिन्ननादिनि महत्यविवेकनाट्ये"
        },
        {
          "file": "045.txt",
          "gathaNum": "045",
          "title": "इत्थं ज्ञानक्रकचकलनापाटनं नाटयित्वा"
        },
        {
          "file": "046.txt",
          "gathaNum": "046",
          "title": "एकः कर्ता चिदहमिह मे कर्म कोपादयोऽमी"
        },
        {
          "file": "047.txt",
          "gathaNum": "047",
          "title": "परपरिणतिमुज्झत् खण्डयद्भेदवादा"
        },
        {
          "file": "048.txt",
          "gathaNum": "048",
          "title": "इत्येवं विरचय्य सम्प्रति परद्रव्यान्निवृत्तिं परां"
        },
        {
          "file": "049.txt",
          "gathaNum": "049",
          "title": "व्याप्यव्यापकता तदात्मनि भवेन्नैवातदात्मन्यपि"
        },
        {
          "file": "050.txt",
          "gathaNum": "050",
          "title": "ज्ञानी जानन्नपीमां स्वपरपरिणतिं पुद्गलश्चाप्यजानन्"
        },
        {
          "file": "051.txt",
          "gathaNum": "051",
          "title": "यः परिणमति स कर्ता यः परिणामो भवेत्तु तत्कर्म"
        },
        {
          "file": "052.txt",
          "gathaNum": "052",
          "title": "एकः परिणमति सदा परिणामो जायते सदैकस्य"
        },
        {
          "file": "053.txt",
          "gathaNum": "053",
          "title": "नोभौ परिणमतः खलु परिणामो नोभयोः प्रजायेत"
        },
        {
          "file": "054.txt",
          "gathaNum": "054",
          "title": "नैकस्य हि कर्तारौ द्वौ स्तो द्वे कर्मणी न चैकस्य"
        },
        {
          "file": "055.txt",
          "gathaNum": "055",
          "title": "आसंसारत एव धावति परं कुर्वेऽहमित्युच्चकै"
        },
        {
          "file": "056.txt",
          "gathaNum": "056",
          "title": "आत्मभावान्करोत्यात्मा परभावान्सदा परः"
        },
        {
          "file": "057.txt",
          "gathaNum": "057",
          "title": "अज्ञानतस्तु सतृणाभ्यवहारकारी"
        },
        {
          "file": "058.txt",
          "gathaNum": "058",
          "title": "अज्ञानान्मृगतृष्णिकां जलधिया धावन्ति पातुं मृगा"
        },
        {
          "file": "059.txt",
          "gathaNum": "059",
          "title": "ज्ञानाद्विवेचकतया तु परात्मनोर्यो"
        },
        {
          "file": "060.txt",
          "gathaNum": "060",
          "title": "ज्ञानादेव ज्वलनपयसोरौष्ण्यशैत्यव्यवस्था"
        },
        {
          "file": "061.txt",
          "gathaNum": "061",
          "title": "अज्ञानं ज्ञानमप्येवं कुर्वन्नात्मानमञ्जसा"
        },
        {
          "file": "062.txt",
          "gathaNum": "062",
          "title": "आत्मा ज्ञानं स्वयं ज्ञानं ज्ञानादन्यत्करोति किम्"
        },
        {
          "file": "063.txt",
          "gathaNum": "063",
          "title": "जीवः करोति यदि पुद्गलकर्म नैव"
        },
        {
          "file": "064.txt",
          "gathaNum": "064",
          "title": "स्थितेत्यविघ्ना खलु पुद्गलस्य"
        },
        {
          "file": "065.txt",
          "gathaNum": "065",
          "title": "स्थितेति जीवस्य निरन्तराया"
        },
        {
          "file": "066.txt",
          "gathaNum": "066",
          "title": "ज्ञानमय एव भावः कुतो भवेत् ज्ञानिनो न पुनरन्यः"
        },
        {
          "file": "067.txt",
          "gathaNum": "067",
          "title": "ज्ञानिनो ज्ञाननिर्वृत्ताः सर्वे भावा भवन्ति हि"
        },
        {
          "file": "068.txt",
          "gathaNum": "068",
          "title": "अज्ञानमयभावानामज्ञानी व्याप्य भूमिकाम्"
        },
        {
          "file": "069.txt",
          "gathaNum": "069",
          "title": "य एव मुक्त्वा नयपक्षपातं"
        },
        {
          "file": "070.txt",
          "gathaNum": "070",
          "title": "एकस्य बद्धो न तथा परस्य"
        },
        {
          "file": "071.txt",
          "gathaNum": "071",
          "title": "एकस्य मूढो न तथा परस्य"
        },
        {
          "file": "072.txt",
          "gathaNum": "072",
          "title": "एकस्य रक्तो न तथा परस्य"
        },
        {
          "file": "073.txt",
          "gathaNum": "073",
          "title": "एकस्य दुष्टो न तथा परस्य"
        },
        {
          "file": "074.txt",
          "gathaNum": "074",
          "title": "एकस्य कर्ता न तथा परस्य"
        },
        {
          "file": "075.txt",
          "gathaNum": "075",
          "title": "एकस्य भोक्ता न तथा परस्य"
        },
        {
          "file": "076.txt",
          "gathaNum": "076",
          "title": "एकस्य जीवो न तथा परस्य"
        },
        {
          "file": "077.txt",
          "gathaNum": "077",
          "title": "एकस्य सूक्ष्मो न तथा परस्य"
        },
        {
          "file": "078.txt",
          "gathaNum": "078",
          "title": "एकस्य हेतुर्न तथा परस्य"
        },
        {
          "file": "079.txt",
          "gathaNum": "079",
          "title": "एकस्य कार्यं न तथा परस्य"
        },
        {
          "file": "080.txt",
          "gathaNum": "080",
          "title": "एकस्य भावो न तथा परस्य"
        },
        {
          "file": "081.txt",
          "gathaNum": "081",
          "title": "एकस्य चैको न तथा परस्य"
        },
        {
          "file": "082.txt",
          "gathaNum": "082",
          "title": "एकस्य सान्तो न तथा परस्य"
        },
        {
          "file": "083.txt",
          "gathaNum": "083",
          "title": "एकस्य नित्यो न तथा परस्य"
        },
        {
          "file": "084.txt",
          "gathaNum": "084",
          "title": "एकस्य वाच्यो न तथा परस्य"
        },
        {
          "file": "085.txt",
          "gathaNum": "085",
          "title": "एकस्य नाना न तथा परस्य"
        },
        {
          "file": "086.txt",
          "gathaNum": "086",
          "title": "एकस्य चेत्यो न तथा परस्य"
        },
        {
          "file": "087.txt",
          "gathaNum": "087",
          "title": "एकस्य दृश्यो न तथा परस्य"
        },
        {
          "file": "088.txt",
          "gathaNum": "088",
          "title": "एकस्य वेद्यो न तथा परस्य"
        },
        {
          "file": "089.txt",
          "gathaNum": "089",
          "title": "एकस्य भातो न तथा परस्य"
        },
        {
          "file": "090.txt",
          "gathaNum": "090",
          "title": "स्वेच्छासमुच्छलदनल्पविकल्पजाला"
        },
        {
          "file": "091.txt",
          "gathaNum": "091",
          "title": "इन्द्रजालमिदमेवमुच्छलत्"
        },
        {
          "file": "092.txt",
          "gathaNum": "092",
          "title": "चित्स्वभावभरभावितभावा"
        },
        {
          "file": "093.txt",
          "gathaNum": "093",
          "title": "आक्रामन्नविकल्पभावमचलं पक्षैर्नयानां विना"
        },
        {
          "file": "094.txt",
          "gathaNum": "094",
          "title": "दूरं भूरिविकल्पजालगहने भ्राम्यन्निजौघाच्च्युतो"
        },
        {
          "file": "095.txt",
          "gathaNum": "095",
          "title": "विकल्पकः परं कर्ता विकल्पः कर्म केवलम्"
        },
        {
          "file": "096.txt",
          "gathaNum": "096",
          "title": "यः करोति स करोति केवलं"
        },
        {
          "file": "097.txt",
          "gathaNum": "097",
          "title": "ज्ञप्तिः करोतौ न हि भासतेऽन्तः"
        },
        {
          "file": "098.txt",
          "gathaNum": "098",
          "title": "कर्ता कर्मणि नास्ति नास्ति नियतं कर्मापि तत्कर्तरि"
        },
        {
          "file": "099.txt",
          "gathaNum": "099",
          "title": "कर्ता कर्ता भवति न यथा कर्म कर्मापि नैव"
        },
        {
          "file": "100.txt",
          "gathaNum": "100",
          "title": "तदथ कर्म शुभाशुभभेदतो"
        },
        {
          "file": "101.txt",
          "gathaNum": "101",
          "title": "एको दूरात्त्यजति मदिरां ब्राह्मणत्वाभिमाना"
        },
        {
          "file": "102.txt",
          "gathaNum": "102",
          "title": "हेतुस्वभावानुभवाश्रयाणां"
        },
        {
          "file": "103.txt",
          "gathaNum": "103",
          "title": "कर्म सर्वमपि सर्वविदो यद्"
        },
        {
          "file": "104.txt",
          "gathaNum": "104",
          "title": "निषिद्धे सर्वस्मिन् सुकृतदुरिते कर्मणि किल"
        },
        {
          "file": "105.txt",
          "gathaNum": "105",
          "title": "यदेतद् ज्ञानात्मा ध्रुवमचलमाभाति भवनं"
        },
        {
          "file": "106.txt",
